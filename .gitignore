# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.eggs/
build/
dist/

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
.env
.env.*
!.env.example

# ── Secrets & API keys ────────────────────────────────────────────────────────
# Runtime config may contain stored API credentials — never commit
config.yaml
secrets.json
*.key
*.pem

# ── Model weights ─────────────────────────────────────────────────────────────
# Large binary checkpoints — downloaded automatically at first run
models/
*.pt
*.pth
*.ckpt
*.bin
*.safetensors

# ── Sample / test images ──────────────────────────────────────────────────────
# Keep your own manga pages off the repo (copyright + file size)
samples/

# ── Runtime metadata sidecars ─────────────────────────────────────────────────
**/metadata/

# ── Fonts ─────────────────────────────────────────────────────────────────────
# Provide your own Korean TTF/OTF in fonts/ — do not commit font files
fonts/*.ttf
fonts/*.otf
fonts/*.woff
fonts/*.woff2

# ── Vendor — must be cloned separately (GPL-3.0 upstream) ────────────────────
vendor/comic_text_detector/

# ── IDE / OS ──────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ── Test / lint caches ────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
